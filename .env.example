# Required for live publishing
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE
TELEGRAM_CHANNEL_ID=@nextlvlgm

# Schedule and state
TIMEZONE=Europe/Warsaw
POST_TIMES=10:00,19:00
MAX_POSTS_PER_RUN=5
HOURS_LOOKBACK=48
DATA_DIR=data
REQUEST_TIMEOUT=15
POST_DELAY_SECONDS=2
LOG_LEVEL=INFO

# Optional: any OpenAI-compatible chat completions endpoint.
# Leave both values empty to use the built-in non-AI formatter.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=

# Safe local preview without posting to Telegram
DRY_RUN=0
